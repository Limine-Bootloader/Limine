common-uefi-loongarch64:
	$(MAKE) -C '$(call SHESCAPE,$(SRCDIR))/common' -f common.mk \
		TARGET=uefi-loongarch64 \
		BUILDDIR='$(call SHESCAPE,$(BUILDDIR))/common-uefi-loongarch64'

