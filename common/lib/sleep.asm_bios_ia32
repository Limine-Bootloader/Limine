section .realmode

int_08_ticks_counter: dd 0
int_08_callback:      dd 0
pit_ticks:            dd 0
tsc_deadline:         dq 0

int_08_isr:
    bits 16
    pushf
    inc dword [cs:int_08_ticks_counter]
    popf
    jmp far [cs:int_08_callback]
    bits 32

extern getchar_internal

global _pit_sleep_and_quit_on_keypress
_pit_sleep_and_quit_on_keypress:
    ; Hook int 0x08
    mov edx, dword [0x08*4]
    mov dword [int_08_callback], edx
    mov dword [0x08*4], int_08_isr

    mov eax, dword [esp+4]
    mov dword [pit_ticks], eax

    mov eax, dword [esp+12]
    mov dword [tsc_deadline], eax
    mov eax, dword [esp+16]
    mov dword [tsc_deadline+4], eax

    ; whether to also break out on pending PS/2 aux (mouse) data
    mov eax, dword [esp+8]
    mov byte [.aux_poll], al

    mov dword [int_08_ticks_counter], 0

    ; Save GDT in case BIOS overwrites it
    sgdt [.gdt]

    ; Save IDT
    sidt [.idt]

    ; Load BIOS IVT
    lidt [.rm_idt]

    ; Save non-scratch GPRs
    push ebx
    push esi
    push edi
    push ebp

    ; Jump to real mode
    jmp 0x08:.bits16
  .bits16:
    bits 16
    mov ax, 0x10
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax
    mov ss, ax
    mov eax, cr0
    and al, 0xfe
    mov cr0, eax
    jmp 0x00:.cszero
  .cszero:
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax
    mov ss, ax

    sti

    mov byte [.mods], 0
    mov byte [.ascii], 0
    mov byte [.scan], 0
    mov byte [.aux_hit], 0

  .loop:
    mov eax, dword [int_08_ticks_counter]
    cmp eax, dword [pit_ticks]
    jae .done

    cmp dword [tsc_deadline+4], 0
    jne .check_tsc
    cmp dword [tsc_deadline], 0
    je .check_aux
  .check_tsc:
    rdtsc
    cmp edx, dword [tsc_deadline+4]
    ja .done
    jb .check_aux
    cmp eax, dword [tsc_deadline]
    jae .done

  .check_aux:
    cmp byte [.aux_poll], 0
    je .no_aux
    in al, 0x64
    and al, 0x21
    cmp al, 0x21
    jne .no_aux
    mov byte [.aux_hit], 1
    jmp .done
  .no_aux:

    mov ah, 0x01
    xor al, al
    int 0x16

    jz .loop

    ; on keypress
    xor ax, ax
    int 0x16
    mov byte [.ascii], al
    mov byte [.scan], ah

    mov ax, 0x0200
    int 0x16
    test al, 0x04
    jz .done

    ; ctrl handling
    mov byte [.mods], 0x04
    add byte [.ascii], 0x60

  .done:
    cli

    ; Restore GDT
    o32 lgdt [.gdt]

    ; Restore IDT
    o32 lidt [.idt]

    ; Jump back to pmode
    mov ebx, cr0
    or bl, 1
    mov cr0, ebx
    jmp 0x18:.bits32
  .bits32:
    bits 32
    mov bx, 0x20
    mov ds, bx
    mov es, bx
    mov fs, bx
    mov gs, bx
    mov ss, bx

    ; Restore non-scratch GPRs
    pop ebp
    pop edi
    pop esi
    pop ebx

    ; Dehook int 0x08
    mov edx, dword [int_08_callback]
    mov dword [0x08*4], edx

    cmp byte [.aux_hit], 0
    jne .aux_break

    cmp byte [.scan], 0
    je .fail

    push dword [.mods]
    push dword [.ascii]
    push dword [.scan]
    call getchar_internal
    add esp, 3*4

    ret

  .aux_break:
    ; XXX: keep in sync with lib/getchar.c
    mov eax, -100
    ret

  .fail:
    xor eax, eax
    ret

  .gdt:      dq 0
  .idt:      dq 0
  .rm_idt:   dw 0x3ff
             dd 0

  .mods:     dd 0
  .ascii:    dd 0
  .scan:     dd 0
  .aux_poll: db 0
  .aux_hit:  db 0
